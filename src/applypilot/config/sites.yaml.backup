# Direct career site registry for ApplyPilot
# Users can add their own sites following this pattern.
# Use {location_encoded} placeholder for location (URL-encoded).
# Use {query_encoded} placeholder for search terms (URL-encoded).

# ── Manual-Only ATS Domains ──────────────────────────────────────────────
# These ATS platforms have unsolvable CAPTCHAs. Jobs routing through them
# are flagged as "manual" during apply — bot skips, user applies by hand.
manual_ats: []
# TCS iBegin removed — agent now has CapSolver + Gmail verification to handle it

# ── Blocked sites — too problematic for automation ───────────────────────
blocked:
  sites:
    - "glassdoor"
    - "google"
    # NOTE: "linkedin" is NOT blocked here — the acquire_job query has
    # fine-grained LinkedIn filtering that allows LinkedIn-discovered
    # jobs with external ATS application URLs (Greenhouse, Ashby, etc.)
    - "accenture"
    - "AccentureCareers"
    - "Workopolis"
  url_patterns:
    - "%glassdoor%"
    - "%google.com/about/careers%"
    - "%google.jobs%"
    - "%linkedin.com%"
    - "%accenture%"
    - "%workopolis.com/out%"
    # Lever — hCaptcha not supported by CapSolver
    - "%jobs.lever.co%"
    # Recruitee — sandboxed CAPTCHA iframe, unsolvable
    - "%recruitee%"
    - "%recruiterbox.com%"
    # TCS iBegin — under maintenance / requires portal account
    - "%ibegin.tcsapps.com%"
    # Ultipro/UKG — requires SSO account creation
    - "%ultipro%"
    # SuccessFactors — requires account creation + CAPTCHA
    - "%successfactors%"
    # Workday — requires account creation, not automatable
    - "%myworkdayjobs.com%"
    - "%workday.com%"
    # Job aggregators — not real ATS, no application forms
    - "%bebee.com%"
    - "%simplyhired%"
    - "%expertini.com%"
    - "%goodspace.ai%"
    - "%careerbeacon.com%"
    - "%designremotejobs.com%"
    - "%abilitycareers.com%"
    - "%jaabz.com%"
    - "%jobright.ai%"
    - "%theladders.com%"
    - "%lensa.com%"
    - "%click.appcast.io%"
    - "%jsv3.recruitics.com%"
    - "%somewhere.com%"
    - "%recruit.net%"
    - "%zippia.com%"
    - "%remotely.de%"
    - "%foundit.in%"
    - "%foundit.sg%"
    - "%founditgulf.com%"
    - "%drjobpro.com%"
    - "%bestjobtool.com%"
    - "%kitjob.in%"
    - "%shine.com%"
    - "%hubmub.com%"
    - "%jobijoba%"
    - "%jobilize.com%"
    - "%fetchjobs.co%"
    - "%hirecrap.com%"
    - "%grabjobs.co%"
    - "%way2fresher.com%"
    - "%myjobmag.com%"
    - "%jobfound.org%"
    - "%scoutit.in%"
    - "%kalibrr.com%"
    # More aggregators / freelance marketplaces — not real job apps
    - "%ziprecruiter.com%"
    - "%hackajob.com%"
    - "%newgrad.in%"
    - "%turing.com%"
    - "%karirpt.com%"
    - "%twine.net%"
    - "%freelancer.com%"
    - "%jobgether.com%"
    - "%hiretechladies.com%"
    - "%learn4good.com%"
    - "%jobzmall.com%"
    - "%serchen.com%"
    - "%fresherjob%"
    - "%space-careers.com%"
    - "%calyptus.co%"
    - "%joinrs.com%"
    - "%adzuna.co%"
    - "%mercor.com%"
    - "%cutshort.io%"
    - "%remotive.com%"
    - "%dice.com%"
    - "%crypto.jobs%"
    - "%trabajo.org%"
    - "%fivestarsjobs.com%"
    - "%applicantz.io%"
    - "%afterquery.com%"
    - "%easyapply.jobs%"
    - "%builtin.com%"
    - "%qatestingjobs.com%"
    - "%nodelabs.hrpanda.co%"
    - "%acensi.group%"
    - "%irissoftware.com%"
    - "%getronics.com%"
    - "%ca.trabajo.org%"
    - "%benture.io%"
    - "%feedinkoo.com%"
    - "%jobalertshub.com%"
    - "%hirelala.com%"
    - "%wiraa.com%"
    - "%motionrecruitment.com%"
    - "%builtinsf.com%"
    - "%builtincolorado.com%"
    - "%builtinnyc.com%"
    - "%builtinaustin.com%"
    - "%builtinla.com%"
    - "%builtinboston.com%"
    - "%builtinseattle.com%"
    - "%builtinchicago.com%"
    # Bad URL patterns that look like ATS but aren't actual job applications
    - "%support.greenhouse.io%"
    - "%www.lever.co/alternative%"
    - "%www.lever.co/blog%"
    - "%www.lever.co/resources%"

# ── Blocked SSO domains — cannot authenticate through these ──────────────
blocked_sso:
  - "accounts.google.com"
  - "login.microsoftonline.com"
  - "okta.com"
  - "auth0.com"
  - "sso.cisco.com"

# ── Base URLs for URL resolution ─────────────────────────────────────────
# Used by detail enrichment to resolve relative URLs scraped from sites.
# Sites not listed here (or with null) cannot have relative URLs resolved.
base_urls:
  "Job Bank Canada": "https://www.jobbank.gc.ca"
  "CareerJet Canada": "https://www.careerjet.ca"
  "BuiltIn Remote": "https://builtin.com"
  "Hacker News Jobs": "https://news.ycombinator.com/"
  "RemoteOK": null
  "WelcomeToTheJungle": null
  "Workopolis": "https://www.workopolis.com"
  "WeWorkRemotely": "https://weworkremotely.com"
  "Startup.jobs": "https://startup.jobs"
  "Nodesk": "https://nodesk.co"
  "Talent.com": "https://www.talent.com"
  "JustRemote": "https://justremote.co"
  "Arc.dev": "https://arc.dev"
  "Himalayas": "https://himalayas.app"
  "Techstars Jobs": "https://www.techstars.com"
  "Randstad Canada": "https://www.randstad.ca/jobs/search/"
  "DailyRemote": "https://dailyremote.com"
  "Jobicy": "https://jobicy.com"
  "Remote.io": "https://www.remote.io"
  "NoHQ": "https://nohq.co"
  "TrueUp": "https://www.trueup.io"
  "Remoters": "https://remoters.net"
  "Landing.jobs": "https://landing.jobs"
  "Authentic Jobs": "https://authenticjobs.com"
  "DynamiteJobs": "https://dynamitejobs.com"
  "4DayWeek": "https://4dayweek.io"
  "Working Nomads": "https://www.workingnomads.com"
  "Jobgether": "https://jobgether.com"
  "Wellfound": "https://wellfound.com"
  "Levels.fyi Jobs": "https://www.levels.fyi"
  "CareerVault": "https://careervault.io"
  "No Fluff Jobs": "https://nofluffjobs.com"
  "Remote AI Jobs": "https://www.moaijobs.com"
  "Underdog.io": "https://underdog.io"

sites:
  # ── Searchable sites (URL includes query + location params) ──────────
  # Canada-specific
  - name: "Eluta"
    url: "https://www.eluta.ca/search?q={query_encoded}&l={location_encoded}"
    type: search

  - name: "Talent.com"
    url: "https://www.talent.com/jobs?k={query_encoded}&l={location_encoded}"
    type: search

  - name: "Randstad Canada"
    url: "https://www.randstad.ca/jobs/?keywords={query_encoded}&location={location_encoded}"
    type: search

  - name: "CareerJet Canada"
    url: "https://www.careerjet.ca/search/jobs?s={query_encoded}&l={location_encoded}"
    type: search

  - name: "Job Bank Canada"
    url: "https://www.jobbank.gc.ca/jobsearch/jobsearch?searchstring={query_encoded}&locationstring={location_encoded}&fage=2&sort=D"
    type: search

  # Startup / AI job boards
  - name: "Work at a Startup"
    url: "https://www.workatastartup.com/jobs?query={query_encoded}"
    type: search

  - name: "Simplify Jobs"
    url: "https://simplify.jobs/jobs?query={query_encoded}"
    type: search

  - name: "Hiring Cafe"
    url: "https://hiring.cafe/jobs?q={query_encoded}"
    type: search

  # General tech (with search)
  - name: "Monster"
    url: "https://www.monster.com/jobs/search?q={query_encoded}&where=Remote&page=1&so=m.h.s"
    type: search

  - name: "Dice"
    url: "https://www.dice.com/jobs?q={query_encoded}&location=Remote&pageSize=100"
    type: search

  - name: "PowerToFly"
    url: "https://powertofly.com/jobs/?keywords={query_encoded}&remote=true"
    type: search

  - name: "Techstars Jobs"
    url: "https://jobs.techstars.com/jobs?keywords={query_encoded}"
    type: search

  - name: "Startup.jobs"
    url: "https://startup.jobs/?q={query_encoded}&remote=true"
    type: search

  - name: "WelcomeToTheJungle"
    url: "https://www.welcometothejungle.com/en/jobs?query={query_encoded}&refinementList%5Bremote%5D%5B%5D=fulltime"
    type: search

  # ── Static sites (no query params, scraped once) ─────────────────────
  # Remote-first boards
  - name: "RemoteOK"
    url: "https://remoteok.com/remote-dev-jobs"
    type: static

